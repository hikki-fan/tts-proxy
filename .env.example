PORT=3000
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Put your real MiMo key in .env or docker-compose environment.
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-tts

# Google Gemini Live API. Gemini provider uses WebSocket Live audio, not REST TTS models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Optional shared token for protecting /api/tts on public networks.
# When set, generated voice-source URLs include ?token=...
ACCESS_TOKEN=

# Optional token for /admin and /api/admin/*.
ADMIN_TOKEN=

DEFAULT_VOICE=mimo_default
DEFAULT_FORMAT=mp3
DEFAULT_SPEED=1
DEFAULT_VOLUME=100
CACHE_ENABLED=true
CACHE_DIR=./data/cache
CACHE_MAX_ITEMS=500
REQUEST_TIMEOUT_MS=120000
